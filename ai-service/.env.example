# 服务
AI_SERVICE_PORT=8000
AI_MOCK_MODE=auto          # auto: 没配 key 的 provider 自动走 mock；always / never
AI_CORS_ORIGINS=*
AI_OUTPUT_DIR=./data/audio

# 模型厂商（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

AIPING_API_KEY=
AIPING_BASE_URL=https://aiping.cn/api/v1

# 跨服务调用（知识检索节点回调 Java 内部接口）
AI_JAVA_SERVICE_BASE_URL=http://127.0.0.1:8084
AI_INTERNAL_TOKEN=agent-flow-internal
