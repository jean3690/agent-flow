# 服务
AI_SERVICE_PORT=8000
AI_MOCK_MODE=auto          # auto: 没配 key 的 provider 自动走 mock；always / never
AI_CORS_ORIGINS=*
AI_OUTPUT_DIR=./data/audio
# 用户上传 / 文件节点读写目录；留空复用 AI_OUTPUT_DIR
AI_FILE_DIR=./data/files
AI_MAX_UPLOAD_MB=50
AI_MAX_READ_CHARS=200000

# 模型厂商（OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 图片翻译 / 实时语音翻译：填写同地域业务空间 API Host，不含协议和路径
AI_DASHSCOPE_API_HOST=
# .env 文件中的 Key 使用 AI_ 前缀；进程环境也兼容 DASHSCOPE_API_KEY
AI_DASHSCOPE_API_KEY=

ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

AIPING_API_KEY=
AIPING_BASE_URL=https://aiping.cn/api/v1

STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.com/v1

# APIFree 入口随账号变化，默认留空；在「模型配置」页填写更稳妥
APIFREE_API_KEY=
APIFREE_BASE_URL=

VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com

# 联网搜索节点（Tavily 直连模式）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# 跨服务调用（知识检索 / 记忆节点回调 Java 内部接口）
AI_JAVA_SERVICE_BASE_URL=http://127.0.0.1:8084
AI_INTERNAL_TOKEN=agent-flow-internal
# Custom Skills are platform-shared, admin-managed; keep separate from file IO.
AI_MANAGED_SKILLS_DIR=./data/skills
# Only deployment operators can allow exact private MCP hosts (no wildcards).
AI_MCP_PRIVATE_HOSTS=
