# 服务
SERVER_PORT=8084
DATABASE_URL=sqlite:///./data/agentflow.db
# MySQL 示例：DATABASE_URL=mysql+pymysql://root:agentflow@127.0.0.1:3306/agent_flow?charset=utf8mb4

# 认证与加密（生产必须替换）
JWT_SECRET=agent-flow-local-secret-key-please-change
JWT_EXPIRE_HOURS=12
APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123
CRYPTO_KEY=agent-flow-local-crypto-key
AI_INTERNAL_TOKEN=agent-flow-internal

# AI 服务
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000
AI_SERVICE_CONNECT_TIMEOUT_MS=5000

# 执行线程池与 SSE 保护
EXECUTION_CORE_POOL_SIZE=4
EXECUTION_MAX_POOL_SIZE=32
EXECUTION_QUEUE_CAPACITY=200
EXECUTION_TRANSPORT_GRACE_MS=5000
EXECUTION_MAX_EVENT_CHARS=2000000

# 浏览器来源
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
