    "configSchema": [
      {
        "key": "provider",
        "label": "模型厂商",
        "type": "select",
        "default": "openai",
        "options": [
          { "label": "OpenAI", "value": "openai" },
          { "label": "DeepSeek", "value": "deepseek" },
          { "label": "通义千问", "value": "qwen" },
          { "label": "智谱 GLM", "value": "zhipu" },
          { "label": "AiPing", "value": "aiping" },
          { "label": "Mock（本地演示）", "value": "mock" }
