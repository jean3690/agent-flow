        "key": "toolIds",
        "label": "启用工具",
        "type": "multiselect",
        "default": ["read_input"],
        "options": [
          { "label": "读取输入", "value": "read_input" },
          { "label": "加载技能", "value": "load_skill" },
          { "label": "知识检索", "value": "knowledge_search" },
          { "label": "网页抓取", "value": "web_fetch" }
        ]
      }
    ]
  },
