  {
    "type": "react_agent",
    "name": "智能体",
    "category": "AI",
    "icon": "Cpu",
    "color": "#8b5cf6",
    "description": "带工具的 ReAct 智能体：可检索知识库、抓取网页、读取输入与加载技能",
