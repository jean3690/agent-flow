SERVER_PORT=8084
SPRING_PROFILES_ACTIVE=local

# local profile uses H2 in-memory database, no MySQL required
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent_flow
MYSQL_USERNAME=root
MYSQL_PASSWORD=agentflow

JWT_SECRET=agent-flow-local-secret-key-please-change
JWT_EXPIRE_HOURS=12

APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123

AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=120000

# ai-service 回调 Java 内部接口时携带的令牌（两边需一致）
AI_INTERNAL_TOKEN=agent-flow-internal

# 服务商 Key 落库加密密钥（更换后旧密文无法解密）
CRYPTO_KEY=agent-flow-local-crypto-key
